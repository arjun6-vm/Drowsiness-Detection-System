# SafeDrive Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your actual credentials.
# NEVER commit your actual .env file with real credentials to version control.

# Gmail SMTP Configuration
# Use a 16-character Google App Password (not your personal Google account password).
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=xxxx_xxxx_xxxx_xxxx

# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017/drowsiness_db

# Flask Application Secret Key
SECRET_KEY=your_secure_random_secret_key_here
